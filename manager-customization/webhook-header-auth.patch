index 0000000..821a9e7
--- /dev/null
+++ b/src/pages/instance/Webhook/headers.ts
@@ -0,0 +1,40 @@
+import { z } from "zod";
+
+const headerNamePattern = /^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/;
+
+export const headerRowsSchema = z
+  .array(
+    z.object({
+      name: z
+        .string()
+        .min(1, "Enter a header name")
+        .max(128)
+        .regex(headerNamePattern, "Invalid HTTP header name")
+        .refine((name) => !["__proto__", "prototype", "constructor"].includes(name.toLowerCase()), "Reserved header name"),
+      value: z
+        .string()
+        .min(1, "Enter the header value or remove this header")
+        .max(8192)
+        .refine((value) => !/[\r\n\0]/.test(value), "Header values cannot contain line breaks"),
+    }),
+  )
+  .superRefine((rows, context) => {
+    const names = new Set<string>();
+    rows.forEach((row, index) => {
+      const name = row.name.toLowerCase();
+      if (names.has(name)) {
+        context.addIssue({ code: z.ZodIssueCode.custom, path: [index, "name"], message: "Header names must be unique" });
+      }
+      names.add(name);
+    });
+  });
+
+export type HeaderRow = z.infer<typeof headerRowsSchema>[number];
+
+export function headersToRows(headers?: Record<string, string> | null): HeaderRow[] {
+  return Object.entries(headers ?? {}).map(([name, value]) => ({ name, value }));
+}
+
+export function rowsToHeaders(rows: HeaderRow[]): Record<string, string> {
+  return Object.fromEntries(headerRowsSchema.parse(rows).map(({ name, value }) => [name, value]));
+}
