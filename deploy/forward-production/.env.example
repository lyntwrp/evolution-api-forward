# Reference only. Fill in the NEW standalone Coolify resource. Never commit secrets.
# Public HTTPS origin, without :8080 or trailing slash:
FORWARD_PROD_SERVER_URL=https://evolution-forward.example.com
# Generate THREE independent random values (64 hex characters avoids URI escaping).
FORWARD_PROD_API_KEY=
FORWARD_PROD_POSTGRES_PASSWORD=
FORWARD_PROD_REDIS_PASSWORD=
# Metadata only: set the exact full commit selected in Coolify. Does not select source.
FORWARD_PROD_SOURCE_REVISION=
FORWARD_PROD_RELEASE=forward-2-3-7-r2
# Optional display names; these DO NOT create or select a WhatsApp instance.
FORWARD_PROD_SERVER_NAME=evolution-forward-production
FORWARD_PROD_PHONE_CLIENT=Evolution API forwardMessage
# Optional instance integrations. Enable only the integrations you configure.
# Instance webhooks work with N8N_ENABLED=false.
FORWARD_PROD_N8N_ENABLED=false
FORWARD_PROD_CHATWOOT_ENABLED=false
FORWARD_PROD_TYPEBOT_ENABLED=false
FORWARD_PROD_OPENAI_ENABLED=false
FORWARD_PROD_DIFY_ENABLED=false
FORWARD_PROD_EVOAI_ENABLED=false
FORWARD_PROD_FLOWISE_ENABLED=false
FORWARD_PROD_RABBITMQ_ENABLED=false
FORWARD_PROD_SQS_ENABLED=false
FORWARD_PROD_KAFKA_ENABLED=false
FORWARD_PROD_NATS_ENABLED=false
FORWARD_PROD_WEBSOCKET_ENABLED=false
FORWARD_PROD_PUSHER_ENABLED=false
FORWARD_PROD_S3_ENABLED=false
