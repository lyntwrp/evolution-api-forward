# Reference only. Create fresh values in the NEW Coolify resource.
# Do not import a production .env, session, credential, database, or backup.
# Public HTTPS origin, without :8080 or trailing slash:
FORWARD_TEST_SERVER_URL=https://evolution-forward-test.example.com
# Set each key/password to a NEW independent random value, e.g. 64 hex chars.
# Hex avoids URL-encoding pitfalls in PostgreSQL/Redis connection URIs.
FORWARD_TEST_API_KEY=
FORWARD_TEST_POSTGRES_PASSWORD=
FORWARD_TEST_REDIS_PASSWORD=
# Optional: exact commit of this custom branch after the changes are committed.
FORWARD_TEST_SOURCE_REVISION=local
